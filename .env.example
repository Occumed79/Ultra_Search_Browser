# Database Configuration (Optional)
# Required for persistent pgvector/search history only. Search retrieval itself
# remains usable without the database.
DATABASE_URL=postgresql://user:password@host:port/database

# Example Neon Database connection string:
# DATABASE_URL=postgresql://username:password@ep-cool-neon-host.us-east-2.aws.neon.tech/neondb?sslmode=require

# Semantic intent planner (Optional / non-core)
# The live procurement planner is deterministic and does not require Gemini.
GEMINI_API_KEY=
GEMINI_INTENT_MODEL=gemini-3.5-flash-lite
# GEMINI_MODEL is accepted as an alias when GEMINI_INTENT_MODEL is not set.
# Retired Flash-Lite model values are migrated to the current stable model automatically.
# Reserved for a later attribution-compliant Google-grounded supplemental search pass.
GEMINI_GROUNDED_SEARCH_MODEL=gemini-3.5-flash-lite

# High-volume semantic reranker (Optional / non-core)
# The live zero-key retrieval and Occu-Med evidence gates do not require these.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_RERANK_MODEL=@cf/baai/bge-reranker-base
# Reserved for future multilingual vector memory; current pgvector memory remains 384-dimensional.
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3

# External smart-filter providers (Optional and OFF by default)
# Merely setting trial provider keys does not put them on the procurement critical
# path. Set ENABLE_EXTERNAL_SMART_FILTER=true only when intentionally testing the
# optional external semantic-review layer. Local Occu-Med filtering remains the
# default and fallback.
ENABLE_EXTERNAL_SMART_FILTER=false
CEREBRAS_API_KEY=
CEREBRAS_SMART_MODEL=gpt-oss-120b

GROQ_API_KEY=
# Full-batch fallback when Cerebras fails
GROQ_SMART_MODEL=openai/gpt-oss-20b
# Selective reviewer for uncertain results and disagreements
GROQ_REVIEW_MODEL=openai/gpt-oss-120b

# Deep page/package validation is always enabled. Up to 48 candidates may be
# opened adaptively with bounded concurrency; extraction is cached for 10 minutes.

# Optional legacy/direct procurement integrations
# These are not required by the core zero-key SearXNG + public-engine retrieval path.
SAM_GOV_API_KEY=

# Advanced Feature Flags (Optional)

# Enable local transformer embeddings (disabled by default due to protobufjs CVE)
# Set to 'true' to enable @xenova/transformers model for real embeddings
# If disabled or fails, falls back to hash-based pseudo-embeddings
ENABLE_LOCAL_EMBEDDINGS=false

# Enable OCR for image text extraction (disabled by default due to performance impact)
# Set to 'true' to enable Tesseract.js OCR
ENABLE_OCR=false
