{
  "name": "ultimate-search-browser",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "smoke": "npx --yes tsx scripts/smoke-search.ts",
    "check:pgvector": "npx --yes tsx scripts/check-pgvector.ts",
    "smoke:pgvector": "npx --yes tsx scripts/smoke-pgvector-search.ts",
    "verify": "npm run typecheck && npm run test:settings && npm run build",
    "test:settings": "npx --yes tsx --test scripts/*.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.1.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@xenova/transformers": "^2.17.2",
    "autoprefixer": "^10.4.20",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.3.1",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.4",
    "pdf-parse": "^1.1.1",
    "pg": "^8.21.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.7.0"
  }
